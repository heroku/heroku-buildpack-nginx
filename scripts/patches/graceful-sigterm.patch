+     * and whatever started nginx is expected to stop it with SIGQUIT.
+     */
+    graceful = getenv("NGINX_GRACEFUL_SIGTERM");
+
     for (sig = signals; sig->signo != 0; sig++) {
         ngx_memzero(&sa, sizeof(struct sigaction));
 
+        if (sig->signo == ngx_signal_value(NGX_TERMINATE_SIGNAL)
+            && graceful != NULL && atoi(graceful) != 0)
+        {
+            sig->handler = NULL;
+        }
+
         if (sig->handler) {
             sa.sa_sigaction = sig->handler;
