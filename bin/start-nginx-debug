#!/usr/bin/env bash

psmgr=/tmp/nginx-buildpack-wait
rm -f $psmgr
mkfifo $psmgr

# With NGINX_GRACEFUL_SIGTERM set, requests that are in flight when the dyno
# is told to stop are finished first. See "Graceful shutdown" in PROXY.md.
graceful=
if [[ "${NGINX_GRACEFUL_SIGTERM:-}" =~ ^[1-9][0-9]*$ ]]
then
  graceful=1
  # Keep the fifo open, so that a process reporting its exit below never has
  # to wait for a reader.
  exec 3<>$psmgr
  # Heroku sends SIGTERM to every process in the dyno, this script included.
  # Survive it, and note that it arrived.
  trap 'stopping=1' TERM
fi

# Evaluate config to get $PORT
erb config/nginx.conf.erb > config/nginx.conf

n=1
while getopts :f option ${@:1:2}
do
  case "${option}"
  in
    f) FORCE=$OPTIND; n=$((n+1));;
  esac
done

# Initialize log directory.
mkdir -p logs/nginx
touch logs/nginx/access.log logs/nginx/error.log
echo 'buildpack=nginx at=logs-initialized'

# Start log redirection.
(
  # tail has no SIGTERM handler of its own, so it inherits this "ignore" and
  # goes on relaying nginx's logs while nginx finishes.
  [[ $graceful ]] && trap '' TERM
  # Redirect nginx logs to stdout.
  tail -qF -n 0 logs/nginx/*.log
  echo 'logs' >$psmgr
) &

# Start App Server
(
  # Outlive SIGTERM, to report when the app has exited. A handler, unlike
  # "ignore", is not passed on, so the app still receives SIGTERM as usual.
  [[ $graceful ]] && trap ':' TERM
  # Take the command passed to this bin and start it.
  # E.g. bin/start-nginx bundle exec unicorn -c config/unicorn.rb
  COMMAND=${@:$n}
  echo "buildpack=nginx at=start-app cmd=$COMMAND"
  $COMMAND
  echo 'app' >$psmgr
) &
app_pid=$!

if [[ -z "$FORCE" ]]
then
  FILE="/tmp/app-initialized"

  # We block on app-initialized so that when nginx binds to $PORT
  # are app is ready for traffic.
  while [[ ! -f "$FILE" && -z "$stopping" ]]
  do
    echo 'buildpack=nginx at=app-initialization'
    sleep 1
  done
  [[ -z "$stopping" ]] && echo 'buildpack=nginx at=app-initialized'
fi

# Start nginx
if [[ -z "$stopping" ]]
then
  (
    # We expect nginx to run in foreground.
    # We also expect a socket to be at /tmp/nginx.socket.
    echo 'buildpack=nginx at=nginx-start'
    if [[ $graceful ]]
    then
      # nginx ignores SIGTERM when NGINX_GRACEFUL_SIGTERM is set. Pass the
      # SIGTERM this subshell receives on to it as SIGQUIT: stop accepting
      # connections, finish the requests in flight, then exit.
      trap 'echo "buildpack=nginx at=nginx-graceful-stop"; kill -QUIT $nginx 2>/dev/null' TERM
      bin/nginx-debug -p . -c config/nginx.conf &
      nginx=$!
      # wait returns early when the trap runs, so wait until nginx is gone.
      while kill -0 $nginx 2>/dev/null
      do
        wait $nginx
      done
    else
      bin/nginx-debug -p . -c config/nginx.conf
    fi
    echo 'nginx' >$psmgr
  ) &
  nginx_pid=$!
fi

# This read will block the process waiting on a msg to be put into the fifo.
# If any of the processes defined above should exit,
# a msg will be put into the fifo causing the read operation
# to un-block. The process putting the msg into the fifo
# will use it's process name as a msg so that we can print the offending
# process to stdout.
[[ -z "$stopping" ]] && read exit_process <$psmgr

if [[ $stopping ]]
then
  # SIGTERM arrived. nginx is finishing the requests in flight and the app is
  # shutting down. Stay until both are done: this script is the dyno's main
  # process, and the dyno ends when it exits.
  echo 'buildpack=nginx at=graceful-shutdown'
  wait $app_pid $nginx_pid
  echo 'buildpack=nginx at=exit process=sigterm'
  exit 0
fi

echo "buildpack=nginx at=exit process=$exit_process"
exit 1
